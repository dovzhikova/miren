# Leave both blank to run Miren in sample mode. No YouCam account required.
#
# API key from https://yce.makeupar.com/api-console/en/api-keys/
# Current Skin Analysis v2.1, Makeup VTO, and Skin Simulation use it as:
#   Authorization: Bearer <YOUCAM_API_KEY>
YOUCAM_API_KEY=

# RSA X.509 public key: the console "Secret key". Paste the base64 body or a PEM.
# When this is set, the server builds an id_token by encrypting
#   client_id=<YOUCAM_API_KEY>&timestamp=<milliseconds>
# and exchanges it at POST /s2s/v1.0/client/auth.
# If that handshake is refused, requests fall back to the V2 API-key bearer above.
# A key that cannot encrypt at all stops the request instead of being ignored.
YOUCAM_PUBLIC_KEY=

# Optional. Documented host. Not a secret.
# YOUCAM_API_BASE=https://yce-api-01.makeupar.com

# Optional. Force sample mode even when an API key is present. Useful for tests.
# MIREN_FORCE_MOCK=1

# Required for live mode: at least 32 random characters. Used only on the server.
MIREN_SESSION_SECRET=

# Durable request quotas. One complete pair is required for live processing.
# Obtain these from an existing authorized Upstash Redis database.
# Vercel Marketplace Upstash may inject KV_REST_API_URL and KV_REST_API_TOKEN
# instead. Those names work as aliases when UPSTASH_REDIS_REST_* are unset.
# If both pairs are set, UPSTASH_REDIS_REST_* is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional task-count caps. Defaults: 5 per session/hour, 100 deployment-wide/UTC day.
# These count task starts, not API units or money.
# MIREN_TASKS_PER_HOUR=5
# MIREN_TASKS_PER_DAY=100
